RATE    equ 1000
MISC    equ 12000
IDFEE   equ 80
LAB     equ 10000
NCOURSE equ 11

%macro pz 1
    mov esi, %1
    call print_z
%endmacro

%macro ask 3
    pz %1
    mov ecx, %2
    mov edx, %3
    call read_line
%endmacro

section .data
