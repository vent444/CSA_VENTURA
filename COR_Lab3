sc0 db "CCS0021   INFORMATION MANAGEMENT (LEC)          TN24    2     T       18:00:00-18:40:00                      ONLINE",10,0
sc1 db "CCS0021L  INFORMATION MANAGEMENT (LAB)          TN24    1     F       16:00:00-18:50:00                      ONLINE",10,0
