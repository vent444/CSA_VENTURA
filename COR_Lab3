space       db " ",0

banner      db "==========================================",10
            db "     CERTIFICATE OF REGISTRATION (COR)",10
            db "==========================================",10,0

p_stud      db "Enter Student #   : ",0
p_name      db "Enter Name        : ",0
p_phone     db "Enter Phone       : ",0
p_college   db "Enter College     : ",0
p_program   db "Enter Program     : ",0
p_year      db "Enter Year Level  : ",0
p_addr      db "Enter Address     : ",0
p_zip       db "Enter Zip Code    : ",0

h_status    db "Enrollment Status : ENROLLED",10,0
h_stud      db "Student # : ",0
h_name      db "Name : ",0
h_phone     db "Phone : ",0
h_zip       db "     Zip Code : ",0
h_class     db "Classification :",10,0
h_college   db "College : ",0
h_program   db "     Program : ",0
h_year      db "Year Level : ",0
h_term      db "     1st term, SY 26-27",10,0
h_addr      db "Address : ",0

